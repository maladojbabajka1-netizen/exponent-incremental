
{
  "name": "exponent-incremental",
  "version": "1.0.0",
  "private": true,
  "description": "EXPONENT - An incremental game",
  "scripts": {
    "build": "echo Building EXPONENT",
    "cap:sync": "cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "desktop": "electron .",
    "package:desktop": "electron-builder"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@capacitor/android": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.exponent.incremental",
    "productName": "EXPONENT",
    "directories": {
      "output": "dist"
    },
    "files": [
      "www/**/*",
      "electron.js"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
